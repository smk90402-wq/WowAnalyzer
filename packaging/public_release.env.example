# Public replay data is read-only and does not require an R2 access key.
# Copy this file to .env only when overriding the release defaults.
WOWANALYZER_PUBLIC_REPLAY_BASE_URL=https://replays.example.com

# Optional. When omitted, the app reads manifest.json under the base URL.
# WOWANALYZER_PUBLIC_REPLAY_MANIFEST_URL=https://replays.example.com/manifest.json
